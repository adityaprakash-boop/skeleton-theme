{% doc %}
  Renders a megamenu layout for a navigation item with child links. The menu
  expands on click using Alpine.js and supports nested child links.

  @param {linklist} menu - Menu object to render
  @param {string} menu_color_scheme - Color scheme handle for menu background
  @param featured_products - Blocks containing featured products from section.blocks

  @example
  {% render 'component-nav-megamenu', menu: section.settings.menu, menu_color_scheme: section.settings.menu_color_scheme, featured_products: section.blocks %}
{% enddoc %}
{% stylesheet %}
  #main-header .nav-megamenu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    margin-top: 1px;
  }
  #main-header .nav-megamenu .page-width {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-inline: auto;
    align-items: flex-start;
    padding: 30px 20px;
  }
  #main-header .nav-megamenu .nav-megamenu_child {
    position: static;
    margin-top: 10px;
    display: block;
  }
  #main-header .nav-megamenu_heading {
    font-weight: 500;
  }
  #main-header .nav-megamenu_child a {
    display: block;
    padding: 6px 0;
    font-size: 15px;
    line-height: 1.5;
  }
  
  /* Featured Products Grid in Megamenu */
  #main-header .nav-megamenu_featured-products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-top: 10px;
  }
  
  #main-header .nav-megamenu_product-card {
    display: flex;
    flex-direction: column;
  }
  
  #main-header .nav-megamenu_product-card a {
    text-decoration: none;
    color: inherit;
  }
  
  #main-header .nav-megamenu_product-image {
    width: 100%;
    aspect-ratio: 1 / 1.2;
    object-fit: cover;
    margin-bottom: 10px;
    background-color: #f5f5f5;
  }
  
  #main-header .nav-megamenu_product-title {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 5px;
    line-height: 1.4;
  }
  
  #main-header .nav-megamenu_product-price {
    font-size: 14px;
    font-weight: 600;
  }
  
  #main-header .nav-megamenu_product-price s {
    color: rgba(var(--color-foreground), 0.5);
    margin-right: 5px;
  }
  /* Underline only for main (top-level) menu items */
#main-header > nav > ul > li > a,
#main-header > nav > ul > li > .menu-toggle {
  position: relative;
  text-decoration: none;
  color: inherit;
  padding: 5px 0;
}

/* Create the center-out underline */
#main-header > nav > ul > li > a::after,
#main-header > nav > ul > li > .menu-toggle::after {
  content: '';
  position: absolute;
  bottom: -3px;
  left: 50%;
  width: 0;
  height: 1px;
  background: currentColor;
  transition: all 0.5s ease;
  transform: translateX(-50%);
}

/* Animate underline on hover (main menu only) */
#main-header > nav > ul > li:hover > a::after,
#main-header > nav > ul > li:hover > .menu-toggle::after {
  width: 100%;
}
/* ---------- Featured Products in Megamenu ---------- */
#main-header .nav-megamenu_featured-products {
  display: flex;
  /* grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); */
  gap: 16px;
  width:300%;
  margin-top: 20px;
  padding: 10px 0;
}

/* Limit card size so it doesn’t stretch */
#main-header .nav-megamenu_product-card-wrapper {
  width: 100%;
  /* max-width: 300px; */
 
  margin: 0 auto;
}

/* Shrink inner product card */
#main-header .nav-megamenu_featured-products .product-card {
  transform: scale(0.9);
  transform-origin: top center;
  transition: all 0.3s ease;
  border: none;
  box-shadow: none;
  background: transparent;
}

/* On hover, gently lift */
/* #main-header .nav-megamenu_featured-products .product-card:hover {
  transform: scale(0.95) translateY(-4px);
} */

/* Fix image stretching */
#main-header .nav-megamenu_featured-products .card-media-child img {
  width: 100%;
  height: auto;
  object-fit: cover;
  aspect-ratio: 1 / 1; /* square image */
  /* border-radius: 6px; */
  
  
}

/* Tighten up info */
#main-header .nav-megamenu_featured-products .card-information {
  text-align: center;
  padding-top: 8px;
}

#main-header .nav-megamenu_featured-products .card-heading a {
  font-size: 14px;
  line-height: 1.4;
  display: block;
  font-weight: 400;
}

#main-header .nav-megamenu_featured-products .card-pricing {
  font-size: 13px;
  margin-top: 4px;
  font-weight: 300;
}

/* Hide quick add buttons to keep it compact */
#main-header .nav-megamenu_featured-products .quick-add {
  display: none !important;
}

/* Hide swatches if accidentally enabled */
#main-header .nav-megamenu_featured-products .product-color-swatches {
  display: none !important;
}

/* Optional: subtle card hover shadow */
#main-header .nav-megamenu_featured-products .product-card:hover {
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  background: #fff;
  border-radius: 8px;
}


  
{% endstylesheet %}
<ul>
  {% for link in menu.links %}
    <li 
      x-data="{ menuOpen: false }" 
      @mouseenter="menuOpen = true" 
      @mouseleave="menuOpen = false"
    >
    

      {% if link.links != blank %}
        <!-- Removed caret icon + hover behavior -->
        <a
          href="{{ link.url }}"
          class="menu-toggle"
          :class="{ 'menu-open': menuOpen }"
        >
          {{- link.title | escape -}}
        </a>
        

        <!-- Megamenu Dropdown -->
        <div
          x-show="menuOpen"
          x-transition
          x-cloak
          class="nav-megamenu color-{{ menu_color_scheme }} gradient"
        >
          <ul class="page-width" role="list">
            {%- for childlink in link.links -%}
              <li>
                <a
                  href="{{ childlink.url }}"
                  class="nav-megamenu_heading"
                  {% if childlink.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ childlink.title | escape }}
                </a>

                {%- if childlink.links != blank -%}
                  <ul class="nav-megamenu_child" role="list">
                    {%- for grandchildlink in childlink.links -%}
                      <li>
                        <a
                          href="{{ grandchildlink.url }}"
                          {% if grandchildlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ grandchildlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- elsif childlink.title == 'FEATURED' and featured_products != blank -%}
                  <div class="nav-megamenu_featured-products">
                    {%- for block in featured_products -%}
                      {%- if block.type == 'featured_product' and block.settings.product != blank -%}
                        {%- assign product = block.settings.product -%}
                        <div class="nav-megamenu_product-card-wrapper">
                          {% render 'component-product-card',
                            card_product: product,
                            show_vendor: false,
                            enable_swatches: false,
                            section_id: 'megamenu'
                          %}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                
              </li>
            {%- endfor -%}
          </ul>
        </div>

      {% else %}
        <!-- Normal link without submenu -->
        <a
          href="{{ link.url }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {% endif %}
    </li>
  {% endfor %}
</ul>
