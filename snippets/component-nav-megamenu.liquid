{% comment %}
  Renders a megamenu layout for a navigation item with child links. The menu
  expands on click using Alpine.js and supports nested child links.

  @param {linklist} menu - Menu object to render
  @param {string} menu_color_scheme - Color scheme handle for menu background
  @param featured_products - Blocks containing featured products from section.blocks

  @example
  {% render 'component-nav-megamenu', menu: section.settings.menu, menu_color_scheme: section.settings.menu_color_scheme, featured_products: section.blocks %}
{% endcomment %}
{% stylesheet %}
  #main-header .nav-megamenu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    margin-top: 1px;
    /* --- NEW: Added for shutter animation --- */
    transform-origin: top;
  }
  #main-header .nav-megamenu .page-width {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-inline: auto;
    align-items: flex-start;
    padding: 30px 40px;
    
    

  }
  #main-header .nav-megamenu .nav-megamenu_child {
    position: static;
    margin-top: 10px;
    display: block;
  }
  #main-header .nav-megamenu_heading {
    font-weight: 500;
    font-size: 18px;
    word-spacing: 2px;
    letter-spacing: 2px;
  }
  #main-header .nav-megamenu_child a {
    display: block;
    padding: 6px 0;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 400;
    word-spacing: 1px;
    letter-spacing: 1px;
  }

  /* Featured Products Grid in Megamenu */
  #main-header .nav-megamenu_featured-products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-top: 10px;
  }

  #main-header .nav-megamenu_product-card {
    display: flex;
    flex-direction: column;
  }

  #main-header .nav-megamenu_product-card a {
    text-decoration: none;
    color: inherit;
  }

  #main-header .nav-megamenu_product-image {
    /* width: 100%; */
    aspect-ratio: 1 / 1.2;
    object-fit: cntain;
    margin-bottom: 10px;
    background-color: #f5f5f5;
  }

  #main-header .nav-megamenu_product-title {
    font-size: 18px;
    font-weight: 400;
    margin-bottom: 5px;
    line-height: 1.4;
    word-spacing: 1.5px;
  }

  #main-header .nav-megamenu_product-price {
    font-size: 16px;
    font-weight: 300;
  }

  #main-header .nav-megamenu_product-price s {
    color: rgba(var(--color-foreground), 0.5);
    margin-right: 5px;
  }

  /* Underline only for main (top-level) menu items */
  #main-header > nav > ul > li > a,
  #main-header > nav > ul > li > .menu-toggle {
    position: relative;
    text-decoration: none;
    color: inherit;
    padding: 5px 0;
  }

  /* Create the center-out underline */
  #main-header > nav > ul > li > a::after,
  #main-header > nav > ul > li > .menu-toggle::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 50%;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: all 0.5s ease;
    transform: translateX(-50%);
  }

  /* Animate underline on hover (main menu only) */
  #main-header > nav > ul > li:hover > a::after,
  #main-header > nav > ul > li:hover > .menu-toggle::after {
    width: 100%;
  }
  /* ---------- Featured Products in Megamenu ---------- */
  #main-header .nav-megamenu_featured-products {
    display: flex;
    /* grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); */
    gap: 16px;
    width: 300%;
   
    padding: 10px 0;
  }

  /* Limit card size so it doesn’t stretch */
  

  /* Shrink inner product card */
  #main-header .nav-megamenu_featured-products .product-card {
    transform: scale(0.9);
    transform-origin: top center;
    transition: all 0.3s ease;
    border: none;
    box-shadow: none;
    background: transparent;
  }

  /* On hover, gently lift */
  /* #main-header .nav-megamenu_featured-products .product-card:hover {
    transform: scale(0.95) translateY(-4px);
  } */

  /* Fix image stretching */
  #main-header .nav-megamenu_featured-products .card-media-child img {
    width: 100%;
    height: auto;
    object-fit: contain;
    aspect-ratio: 1 / 1; /* square image */
    /* border-radius: 6px; */
  }

  /* Tighten up info */
  #main-header .nav-megamenu_featured-products .card-information {
    text-align: center;
    padding-top: 8px;
  }

  #main-header .nav-megamenu_featured-products .card-heading a {
    font-size: 14px;
    line-height: 1.4;
    display: block;
    font-weight: 400;
  }

  #main-header .nav-megamenu_featured-products .card-pricing {
    font-size: 13px;
    margin-top: 4px;
    font-weight: 300;
  }

  /* Hide quick add buttons to keep it compact */
  #main-header .nav-megamenu_featured-products .quick-add {
    display: none !important;
  }

  /* Hide swatches if accidentally enabled */
  #main-header .nav-megamenu_featured-products .product-color-swatches {
    display: none !important;
  }

  /* Optional: subtle card hover shadow */
  #main-header .nav-megamenu_featured-products .product-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    background: #fff;
    border-radius: 8px;
  }

  /* --- NEW: Add these classes for the slide animation --- */

  #main-header .nav-megamenu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    margin-top: 1px;
    /* Optional: Improves performance */
    will-change: clip-path, transform;
  }

  /* --- CORRECTED: Shutter Animation using clip-path for Alpine.js v2 --- */

  /* Defines the transition properties for the 'enter' phase */
  .shutter-enter {
    transition: clip-path 0.2s ease-out, transform 0.2s ease-out;
  }

  /* The starting state: fully clipped from the bottom and slightly moved up */
  .shutter-enter-start {
    clip-path: inset(0 0 100% 0);
    transform: translateY(-15px);
  }

  /* The ending state: fully visible and in its final position */
  .shutter-enter-end {
    clip-path: inset(0 0 0% 0);
    transform: translateY(0);
  }

  /* Defines the transition properties for the 'leave' phase */
  .shutter-leave {
    transition: clip-path 0.2s ease-in;
  }

  /* The starting state when leaving: fully visible */
  .shutter-leave-start {
    clip-path: inset(0 0 0% 0);
  }

  /* The ending state when leaving: fully clipped from the bottom */
  .shutter-leave-end {
    clip-path: inset(0 0 100% 0);
  }
