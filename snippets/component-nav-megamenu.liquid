{% endstylesheet %}
<ul>
  {% for link in menu.links %}
    <li x-data="{ menuOpen: false }">
      {% if link.links != blank or link.title == 'ABOUT' %}
        <a
          href="{{ link.url }}"
          class="menu-toggle"
          @click.prevent="menuOpen = !menuOpen"
          :class="{ 'menu-open': menuOpen }"
        >
          {{- link.title | escape -}}
        </a>

        <!-- Megamenu Dropdown -->
        <div
          x-show="menuOpen"
          x-cloak
          class="nav-megamenu color-{{ menu_color_scheme }} gradient"
          x-transition:enter="shutter-enter"
          x-transition:enter-start="shutter-enter-start"
          x-transition:enter-end="shutter-enter-end"
          x-transition:leave="shutter-leave"
          x-transition:leave-start="shutter-leave-start"
          x-transition:leave-end="shutter-leave-end"
        >
          {% if link.title == 'ABOUT' %}
            {% assign about_blocks = section.blocks | where: 'type', 'about_block' %}
            {% if about_blocks.size > 0 %}
              <div class="nav-megamenu_about-blocks">
                {% for block in about_blocks %}
                  <a href="{{ block.settings.url }}" class="nav-megamenu_about-block">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}">
                    {% endif %}
                    {% if block.settings.name != blank %}
                      <div class="nav-megamenu_about-name">{{ block.settings.name }}</div>
                    {% endif %}
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          {% endif %}
          <ul class="page-width" role="list">
            {%- for childlink in link.links -%}
              <li>
                <a
                  href="{{ childlink.url }}"
                  class="nav-megamenu_heading"
                  {% if childlink.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ childlink.title | escape }}
                  {% if childlink.title contains 'SHOP ALL' %}
                    <span style="display:inline-block; margin-left:6px; vertical-align:middle;">
                      {{ 'Vector.svg' | inline_asset_content }}
                    </span>
                  {% endif %}
                </a>
                

                {%- if childlink.links != blank -%}
                  <ul class="nav-megamenu_child" role="list">
                    {%- for grandchildlink in childlink.links -%}
                      <li>
                        <a
                          href="{{ grandchildlink.url }}"
                          {% if grandchildlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ grandchildlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- elsif childlink.title == 'FEATURED' and featured_products != blank -%}
                  <div class="nav-megamenu_featured-products">
                    {%- for block in featured_products -%}
                      {%- if block.type == 'featured_product' and block.settings.product != blank -%}
                        {%- assign product = block.settings.product -%}
                        <div class="nav-megamenu_product-card-wrapper">

                          <div class="nav-megamenu_product-card">
                            <a href="{{ product.url }}">
                              {%- if product.featured_image -%}
                                <img
                                  src="{{ product.featured_image | image_url: width: 400 }}"
                                  alt="{{ product.featured_image.alt | escape }}"
                                  class="nav-megamenu_product-image"
                                  width="200"
                                  height="240"
                                  loading="lazy"
                                >
                              {%- else -%}
                                <div class="nav-megamenu_product-image" style="background-color: #f0f0f0;"></div>
                              {%- endif -%}
                            </a>

                            <!-- 1. ALWAYS-VISIBLE INFO -->
                            <div class="nav-megamenu_product-info-visible">
                              <div class="nav-megamenu_product-title">
                                {{ product.title }}
                              </div>
                              <div class="nav-megamenu_product-price">
                                {%- if product.compare_at_price > product.price -%}
                                  <s>{{ product.compare_at_price | money }}</s>
                                {%- endif -%}
                                <span>{{ product.price | money }}</span>
                              </div>
                            </div>

                            <!-- 2. SLIDING HOVER PANEL (with duplicated info + buttons) -->
                            <div class="nav-megamenu_product-info-hover">
                              <div class="nav-megamenu_product-title">
                                {{ product.title }}
                              </div>
                              <div class="nav-megamenu_product-price">
                                {%- if product.compare_at_price > product.price -%}
                                  <s>{{ product.compare_at_price | money }}</s>
                                {%- endif -%}
                                <span>{{ product.price | money }}</span>
                              </div>
                              <div class="nav-megamenu_buttons">
                                <div class="btn btn-subscribe">SUBSCRIBE & SAVE 20%</div>
                                <div class="btn btn-add-to-cart">ADD TO CART</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {% if link.title != 'ABOUT' %}
           <!-- SHOP ALL BUTTON -->
           <div class="nav-megamenu_shop-all">
            <a href="{{ link.url }}" class="shop-all-btn">SHOP ALL</a>
          </div>
          {% endif %}
        </div>

      {% else %}
        <!-- Normal link without submenu -->
        <a
          href="{{ link.url }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {% endif %}
    </li>
  {% endfor %}
</ul>