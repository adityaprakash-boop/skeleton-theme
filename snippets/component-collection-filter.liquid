<form id="custom-filter-form">
  <div class="custom-filters">
    <div class="filter-options">
      {% assign sorted_filters = collection.filters | sort: 'label' %}
      {% for filter in sorted_filters %}
        {% if filter.values.size > 0 and filter.param_name contains 'p.m.' %}
          <div class="filter-group" x-data="{ open:false }" @click.outside="open=false" @keydown.escape.window="open=false" x-effect="document.body.classList.toggle('desktop-dropdown-open', open)">

            <h3 class="filter-title" @click="open = !open">
              {{ filter.label }}

              <span class="dropdown-icon" :class="{ 'open':open }">
                {{ 'icon-close3.svg' | inline_asset_content }}
              </span>
            </h3>

            <div class="filter-list" x-show="open">
              <div class="filter-list-items">
                {% for value in filter.values %}
                  {% assign value_label_handle = value.label | handleize %}
                  <label class="filter-value-label">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      data-render-section
                      data-filter-label-handle="{{ value_label_handle }}"
                      {% if value_label_handle == 'energy-vitality' %}
                        data-ignore-apply
                      {% endif %}
                      {% if value.active %}
                        checked
                      {% endif %}
                      {% if value_label_handle == 'detox' %}
                        disabled
                      {% endif %}
                      {% if value.count == 0 and value.active == false %}
                        disabled
                      {% endif %}
                    >

                    <span class="filter-value-1">{{ value.label }}</span>
                    <span class="filter-value-2">({{ value.count }})</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="shop-sort-btn-wrapper">
      <div class="shop-all-btn">
        <a href="#" class="shop-all-btn-link">SHOP ALL</a>
      </div>
      <div class="custom-sort-line"></div>
      <div class="custom-sort" x-data="{ open:false }" @click.outside="open=false" @keydown.escape.window="open=false" x-effect="document.body.classList.toggle('desktop-dropdown-open', open)">

        <h3 class="sort-title" @click="open = !open; if(open) { $nextTick(() => $refs.sortSelect.focus()); }">
          SORT BY:
          <span class="sort-icon" :class="{ 'open':open }">
            {{ 'icon-close3.svg' | inline_asset_content }}
          </span>
        </h3>
      
        <div class="sort-list" x-show="open">
          {% for option in collection.sort_options %}
            <label class="sort-option-item" @click="$refs.sortSelect.value = '{{ option.value }}'; const changeEvent = new Event('change', { bubbles: true, cancelable: true }); $refs.sortSelect.dispatchEvent(changeEvent); open = false;">
              <span {% if option.value == collection.sort_by %}style="font-weight: 500;"{% endif %}>
                {{ option.name }}
              </span>
            </label>
          {% endfor %}
        </div>
        
        <select
          x-ref="sortSelect"
          id="SortBy-{{ section.id }}"
          name="sort_by"
          data-render-section
          style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;"
        >
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
      </div>
      
    </div>
  </div>
</form>
