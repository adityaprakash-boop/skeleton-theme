{%- style -%}
  .filters-sidebar {
    margin-bottom: 20px;
    width: 280px;
    margin-right: 40px;
    flex-shrink: 0;
    background: #FFFFFF;
  }

  .facets__heading {
    display: block;
    color: #212121;
    font-size: 1.8rem;
    margin-bottom: 20px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .filter-section {
    border-bottom: 1px solid #DADADA;
    margin-right: 0;
  }

  .filter-section:last-child {
    border-bottom: none;
  }

  .facets__disclosure-vertical summary {
    padding: 20px 0;
  }

  .facets__disclosure-vertical details[open] summary .icon-caret {
    transform: rotate(180deg);
  }

  .facets__disclosure-vertical summary {
    cursor: pointer;
    list-style: none;
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .facets__disclosure-vertical summary span {
    font-size: 15px;
    color: #212121;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .facets__disclosure-vertical summary .icon-caret {
    position: absolute;
    height: 12px;
    width: 12px;
    right: 0px;
    top: calc(50% - 6px);
    opacity: 0.6;
  }

  .facets__display-vertical {
    display: flex;
    flex-direction: column;
    padding: 0 0 20px 0;
    gap: 8px;
  }

  .filters__show-more {
    background: transparent;
    border: 1px solid #DADADA;
    padding: 8px 16px;
    cursor: pointer;
    margin-top: 8px;
    font-size: 14px;
    color: #212121;
    transition: all 0.2s ease;
    border-radius: 4px;
  }

  .filters__show-more:hover {
    background: #F5F5F5;
    border-color: #212121;
  }

  /* Checkbox styles to match Figma circular radio buttons */
  .facet-checkbox {
    padding: 10px 0;
    flex-grow: 1;
    position: relative;
    font-size: 15px;
    display: flex;
    align-items: center;
    word-break: break-word;
    cursor: pointer;
    line-height: 1.4;
    color: #212121;
  }

  .facet-checkbox:hover {
    opacity: 0.8;
  }

  .facet-checkbox input[type='checkbox'] {
    position: absolute;
    opacity: 0;
    width: 20px;
    height: 20px;
    top: 10px;
    left: 0;
  }

  /* Hide default square icon and show circular style */
  .facet-checkbox > svg {
    display: none;
  }

  .facet-checkbox::before {
    content: '';
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #DADADA;
    margin-right: 10px;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .facet-checkbox input:checked ~ .svg-wrapper {
    visibility: visible;
    position: absolute;
    left: 5px;
    top: 14px;
    width: 11px;
    height: 11px;
    z-index: 1;
  }

  .facet-checkbox input:checked ~ .svg-wrapper .icon-checkmark {
    stroke: #212121;
    stroke-width: 1.5px;
  }

  .facet-checkbox input:checked::before,
  .facet-checkbox:has(input:checked)::before {
    background: #DADADA;
  }

  .facet-checkbox:has(input:disabled) {
    opacity: 0.4;
    pointer-events: none;
  }

  .reset-button {
    font-size: 13px;
    color: #212121;
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .reset-button:hover {
    opacity: 1;
  }
{%- endstyle -%}

{% assign show_more_number = 10 %}
<aside class="filters-sidebar small-hide">
  {% liquid
    assign open = true
    if collapse_filters
      assign open = false
    endif
  %}

  <div class="facets__main-head-wrapper">
    <h2 class="facets__heading">Filter:</h2>
  </div>
  <form id="filters-form">
    {% for f in results.filters %}
      <div
        class="filter-section facets__disclosure-vertical js-filter"
        id="Details-{{ f.param_name | escape }}-{{ section.id }}"
        x-data="{ open: {{ open }} }"
      >
        <details
          x-bind:open="open"
          @toggle="open = $event.target.open"
        >
          <summary>
            <span>
              {{ f.label }}
              {% if f.active_values.size > 0 %}
                ({{ f.active_values.size }})
                <a
                  class="reset-button"
                  data-render-section-url="{{ f.url_to_remove }}"
                  href="{{ f.url_to_remove }}"
                  >reset
                </a>
              {% endif %}
            </span>
            {{ 'icon-caret.svg' | inline_asset_content }}
          </summary>
          <div
            class="facets__display-vertical"
            x-data="{ showMore : $persist(false).as('sm-{{ f.param_name }}') }"
          >
            {% if f.type == 'price_range' %}
              {% render 'component-filters-price-range', filter: f, id_prefix: 'Filter-', filter_type: filter_type %}
            {% else %}
              {% for v in f.values %}
                {% assign input_id = 'Filter-' | append: f.param_name | escape | append: '-' | append: forloop.index %}
                <label
                  class="facet-checkbox"
                  {% if forloop.index > show_more_number %}
                    x-show="showMore"
                    x-transition
                  {% endif %}
                >
                  <input
                    id="{{ input_id }}"
                    type="checkbox"
                    name="{{ v.param_name }}"
                    value="{{ v.value }}"
                    data-render-section="filters-form"
                    {% if v.active %}
                      checked
                    {% endif -%}
                    {% if v.count == 0 and v.active == false %}
                      disabled
                    {% endif -%}
                  >
                  {{- 'icon-square.svg' | inline_asset_content -}}
                  <div class="svg-wrapper">
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                  </div>
                  {{- v.label }} ({{ v.count }})
                </label>
              {% endfor %}
            {% endif %}
            {%- if f.type != 'price_range' and f.values.size > show_more_number -%}
              <button
                type="button"
                class="filters__show-more"
                x-on:click="showMore = !showMore"
                x-text="showMore ? 'Show less' : 'Show more'"
              >
                Show more
              </button>
            {%- endif %}
          </div>
        </details>
      </div>
    {% endfor %}
  </form>
</aside>
