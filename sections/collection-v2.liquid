{{ 'section-collection-v2.css' | asset_url | stylesheet_tag }}
<collection-v2 class="collection-block-list" data-section="{{ section.id }}">
  <div class="collection-banner">
    <div class="collection-banner-image">
      {% if section.settings.banner_image %}
        <img
          src="{{ section.settings.banner_image | image_url: width: 1800 }}"
          alt="Banner"
          class="collection-banner__image"
        >
      {% endif %}
    </div>

    {% if section.settings.banner_text %}
      <div class="collection-banner__text">
        {{ section.settings.banner_text }}
      </div>
    {% endif %}
  </div>
  <div class="collection-nav">
    {% for block in section.blocks %}
      {% assign collection_obj = collections[block.settings.collection] %}
      {% if collection_obj %}
        <div
          class="collection-nav-item"
          @click="const top = $refs['collection_obj{{ forloop.index }}'].offsetTop;window.scrollTo({ top: top - 10, behavior: 'smooth' });"
        >
          {{ collection_obj.title }}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="mobile-filter-bar">
    <div class="mobile-filter-bar-text">
      <span class="mobile-count">{{ collection.products_count }} Products</span>

      <a href="#" class="mobile-shop-all">SHOP ALL</a>
    </div>
    <div class="mobile-filter-bar-button">
      <button class="mobile-refine-btn">REFINE BY {{ 'icon-filter-v2.svg' | inline_asset_content }}</button>
    </div>
  </div>

  <div class="custom-filters">
    <div class="filter-options">
      
      {% assign sorted_filters = collection.filters | sort: 'label' %}
      {% for filter in sorted_filters %}
        {% if filter.values.size > 0 and filter.param_name contains 'p.m.' %}
          <div class="filter-group" x-data="{ open:false }">
            <h3 class="filter-title" @click="open = !open">
              {{ filter.label }}

              <span class="dropdown-icon" :class="{ 'open':open }">
                {{ 'icon-close3.svg' | inline_asset_content }}
              </span>
            </h3>

            <div class="filter-list" x-show="open">
              <div class="filter-list-items">
                {% for value in filter.values %}
                  <a href="{{ value.url_to_add }}" @click="open = false" data-filter-link>
                    <div class="filter-value-label">
                      <span class="filter-value-1">{{ value.label }}</span>
                      <span class="filter-value-2">({{ value.count }})</span>
                    </div>
                  </a>
                {% endfor %}
              </div>
              <a href="#" class="filter-apply-all">APPLY</a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="shop-sort-btn-wrapper">
      <div class="shop-all-btn">
        <a href="#" class="shop-all-btn-link">SHOP ALL</a>
      </div>
      <div class="custom-sort-line"></div>
      <div class="custom-sort" x-data="{ open:false }">
        <h3 class="sort-title" @click="open = !open">
          SORT BY:
          <span class="sort-icon" :class="{ 'open':open }">
            {{ 'icon-close3.svg' | inline_asset_content }}
          </span>
        </h3>

        <div class="sort-list" x-show="open">
          {% for option in collection.sort_options %}
            <a href="?sort_by={{ option.value }}" data-sort-link class="sort-item">
              {{ option.name }}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  <div class="active-filter-bar" style="display: none;">
    <div class="active-filter-text" ><span></span> <div class="active-filter-clear-all-icon">{{ 'icon-close.svg' | inline_asset_content }}</div></div>
    <div class="active-filter-clear-all">
      <a href="#" class="clear-all-btn"><span>Clear All </span></a>
    </div>
  </div>

  {% liquid
    assign filter_active = false
    for f in collection.filters
      if f.active_values.size > 0
        assign filter_active = true
      endif
    endfor
  %}
  <div id="results-area">
    {% if filter_active %}
      <div class="filtered-results-wrapper">
        <div class="collection-products">
          {% for product in collection.products %}
            {% render 'component-product-card-v2', product: product, forloop: forloop %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="collection-block-wrapper">
        {% for block in section.blocks %}
          {% assign collection_obj = collections[block.settings.collection] %}

          {% if collection_obj %}
            <div
              class="collection-block"
              x-ref="collection_obj{{ forloop.index }}"
              style="background: {{ block.settings.collection_bg }};"
            >
              {% render 'component-collection-info',
                collection_obj: collection_obj,
                custom_title: block.settings.custom_title
              %}
              <div class="collection-products">
                {% if block.settings.collection_block_image %}
                  <div class="collection-block-image-wrapper">
                    <div class="collection-block-image-inner">
                      <img
                        src="{{ block.settings.collection_block_image | image_url: width: 1200 }}"
                        alt="{{ block.settings.custom_image_text | default: 'Collection image' }}"
                        class="collection-block-image"
                      >
                    </div>

                    {% if block.settings.custom_image_text1 != blank %}
                      <div class="collection-block-image-text">
                        <div class="collection-block-image-text-item1">{{ block.settings.custom_image_text1 }}</div>
                        <div class="collection-block-image-text-item2">{{ block.settings.custom_image_text2 }}</div>
                        <div class="collection-block-image-text-item3">{{ block.settings.custom_image_text3 }}</div>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

                {% for product in collection_obj.products %}
                  {% render 'component-product-card-v2', product: product, forloop: forloop %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</collection-v2>
<script src="{{ 'section-collection-v2.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Multi Collection Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner Text"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Collection Title"
        },
        {
          "type": "image_picker",
          "id": "collection_block_image",
          "label": "Collection Block Image"
        },
        {
          "type": "text",
          "id": "custom_image_text1",
          "label": "Collection Block Image Text"
        },
        {
          "type": "text",
          "id": "custom_image_text2",
          "label": "Collection Block Image Text"
        },
        {
          "type": "text",
          "id": "custom_image_text3",
          "label": "Collection Block Image Text"
        },

        {
          "type": "color",
          "id": "collection_bg",
          "label": "Collection Block Background",
          "default": "#FBF8F4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi Collection Section"
    }
  ]
}
{% endschema %}
