{% comment %}
  Announcement Bar Section
  Displays a customizable announcement banner at the top of the page with rotating text
{% endcomment %}

<link rel="stylesheet" href="https://use.typekit.net/sjm2dby.css">

{%- liquid
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
-%}

<style>
  #shopify-section-{{ section.id }} {
    --announcement-bg-color: {{ background_color }};
    --announcement-text-color: {{ text_color }};
    padding: 0;
    margin: 0;
  }
</style>

{% stylesheet %}
.announcement-bar-section .announcement-bar {
  background-color: var(--announcement-bg-color, #000000);
  color: var(--announcement-text-color, #FFFFFF);
  width: 100%;
  position: relative;
  overflow: hidden;
}

.announcement-bar-section .announcement-bar__container {
  padding-top: 12px;
  padding-bottom: 12px;
  padding-left: 2rem;
  padding-right: 2rem;
  text-align: center;
  max-width: 100%;
  margin: 0 auto;
  position: relative;
  min-height: 1.5em;
}

.announcement-bar-section .announcement-bar__text-wrapper {
  position: relative;
  display: inline-block;
  width: 100%;
}

.announcement-bar-section .announcement-bar__text {
  margin: 0;
  font-size: 1.4rem;
  font-weight: 100;
  line-height: 1.5;
  color: var(--announcement-text-color, rgb(250, 248, 248));
  font-family: "josefin-sans", sans-serif;
  position: absolute;
  width: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.8s ease-in-out, visibility 0s linear 0.8s;
  top: 0;
  left: 0;
}

.announcement-bar-section .announcement-bar__text.active {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.8s ease-in-out, visibility 0s linear 0s;
  position: relative;
}

@media screen and (max-width: 768px) {
  .announcement-bar-section .announcement-bar__text {
    font-size: 1.2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .announcement-bar-section .announcement-bar__text {
    transition: none;
  }
}
{% endstylesheet %}

{%- if section.blocks.size > 0 -%}
  <announcement-rotator
    class="announcement-bar full-width section-{{ section.id }}-padding"
    data-section-id="{{ section.id }}"
  >
    <div class="announcement-bar__container">
      <div class="announcement-bar__text-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <p class="announcement-bar__text" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </announcement-rotator>
{%- endif -%}

<script src="{{ 'section-announcement-bar.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#254430"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement_text",
      "name": "Announcement Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Enter Your Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}

