<section class="journal-section">
    <div class="journal-header">
      {% if section.settings.heading != blank %}
        <h2 class="journal-heading">{{ section.settings.heading }}</h2>
      {% endif %}
  
      {% if section.settings.description != blank %}
        <p class="journal-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>
  
    <div class="journal-row">
      {% for block in section.blocks %}
        <div class="journal-card">
  
          <div class="journal-img-wrap">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 800 }}"
                class="journal-img"
                loading="lazy">
            {% endif %}
          </div>
  
          {% if block.settings.category != blank %}
            <p class="journal-category">{{ block.settings.category }}</p>
          {% endif %}
  
          {% if block.settings.title != blank %}
            <p class="journal-title">{{ block.settings.title }}</p>
          {% endif %}
  
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="journal-view">View</a>
          {% endif %}
  
        </div>
      {% endfor %}
    </div>
  
    {% if section.settings.button_label != blank %}
      <div class="journal-button-wrap">
        <a href="{{ section.settings.button_link }}" class="journal-button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </section>
  
  <style>
    .journal-section {
      padding: 60px 20px;
      text-align: center;
      background-color: #FAF8F5;
      font-family: "Futura PT", sans-serif;
    }
  
    .journal-header {
      max-width: 700px;
      margin: 0 auto 40px;
    }
  
    .journal-heading {
      font-size: 38px;
      margin-bottom: 10px;
    }
  
    .journal-description p{
      font-size: 14px;
      
    }
  
    /* Desktop row */
    .journal-row {
      display: flex;
      gap: 30px;
      margin-bottom: 40px;
    }
  
    .journal-card {
      flex: 1;
      min-width: 0;
      text-align: left;
    }
  
    /* Image wrapper 4:5 ratio */
    .journal-img-wrap {
        width: 100%;
        aspect-ratio: 4 / 5;
        background: #eee;
        
      }
      
      .journal-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      
  
    .journal-category {
      font-size: 1rem;
      margin-top: 12px;
      letter-spacing: 1px;
    }
  
    .journal-title {
      font-size: 25px;
      margin: 10px 0;
    }
  
    .journal-view {
      font-size: 13px;
      text-decoration: none;
      color: black;
      border-bottom: 1px solid black;
    }
  
    .journal-button-wrap {
      text-align: center;
    }
  
    .journal-button {
      
      font-size: 14px;
      border-bottom: 1px solid black;
      
      text-decoration: none;
      color: black;
    }
  
    /* Mobile horizontal scroll — NOT grid */
    @media (max-width: 768px) {
      .journal-row {
        overflow-x: auto;
        display: flex;
        gap: 20px;
        padding-bottom: 10px;
        -webkit-overflow-scrolling: touch;
      }
      .journal-row::-webkit-scrollbar {
        display: none;                /* Chrome, Safari */
      }
  
      .journal-card {
        flex: 0 0 70%;
      }
  
      {% comment %} .journal-img-wrap {
        padding-top: 140%;
      } {% endcomment %}
    }
  </style>
  
  {% schema %}
  {
    "name": "The Journal",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "THE JOURNAL"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Supporting description text with bold or italic for emphasis."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "EXPLORE MORE"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "blocks": [
      {
        "type": "article_card",
        "name": "Article",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Article Image"
          },
          {
            "type": "text",
            "id": "category",
            "label": "Category",
            "default": "BLOG CATEGORY"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Article Title",
            "default": "Read the headline of a journal article over two or three lines of text if required."
          },
          {
            "type": "url",
            "id": "link",
            "label": "Article Link"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "The Journal"
      }
    ]
  }
  {% endschema %}
  