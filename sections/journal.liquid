<link rel="stylesheet" href="https://use.typekit.net/sjm2dby.css">
<section class="journal-section">
    <div class="journal-header">
      <div class="journal-heading-wrap">
        {% if section.settings.heading_1 != blank %}
          <h2 class="journal-heading heading-1">{{ section.settings.heading_1 }}</h2>
        {% endif %}
        
        {% if section.settings.heading_2 != blank %}
          <h2 class="journal-heading heading-2">{{ section.settings.heading_2 }}</h2>
        {% endif %}
      </div>
      
  
     
        <div class="journal-description">
          {% if section.settings.description_1 != blank %}
            <p class="journal-description-1">{{ section.settings.description_1 }}</p>
          {% endif %}
        
          {% if section.settings.description_2 != blank %}
            <div class="journal-description-2-wrap">
              <p class="journal-description-2">{{ section.settings.description_2 }}</p>
            </div>
          {% endif %}
        
          {% if section.settings.description_3 != blank %}
            <p class="journal-description-3">{{ section.settings.description_3 }}</p>
          {% endif %}
        </div>
        
      
    </div>
  
    <div class="journal-row">
      {% for block in section.blocks %}
        <div class="journal-card">
  
          <div class="journal-img-wrap">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 800 }}"
                class="journal-img"
                loading="lazy">
            {% endif %}
          </div>
  
          {% if block.settings.category != blank %}
            <p class="journal-category">{{ block.settings.category }}</p>
          {% endif %}
  
          {% if block.settings.title != blank %}
            <p class="journal-title">{{ block.settings.title }}</p>
          {% endif %}
  
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="journal-view">View</a>
          {% endif %}
  
        </div>
      {% endfor %}
    </div>
  
    {% if section.settings.button_label != blank %}
      <div class="journal-button-wrap">
        <a href="{{ section.settings.button_link }}" class="journal-button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </section>
  
  <style>
    .journal-section {
      padding: 50px 50px;
      text-align: center;
      background-color: #FAF8F5;
      font-family: "Futura PT", sans-serif;
    }
  
    .journal-header {
      max-width: 700px;
      margin: 0 auto 40px;
    }
  
    .journal-heading {
      font-size: 38px;
      margin-bottom: 10px;
    }
  
    .journal-description p{
      font-size: 14px;
      
    }
  
    /* Desktop row */
    .journal-row {
      display: flex;
      gap: 25px;
      margin-bottom: 40px;
    }
  
    .journal-card {
      flex: 1;
      min-width: 0;
      text-align: left;
    }
  
    /* Image wrapper 4:5 ratio */
    .journal-img-wrap {
        width: 100%;
        aspect-ratio: 4 / 5;
        background: #eee;
        
      }
      
      .journal-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      
  
    .journal-category {
      font-size: 1rem;
      margin-top: 12px;
      letter-spacing: 1px;
    }
  
    .journal-title {
      font-size: 25px;
      margin: 10px 0;
    }
  
    .journal-view {
      font-size: 13px;
      text-decoration: none;
      color: black;
      border-bottom: 1px solid black;
    }
  
    .journal-button-wrap {
      text-align: center;
    }
  
    .journal-button {
      
      font-size: 14px;
      border-bottom: 1px solid black;
      
      text-decoration: none;
      color: black;
    }
  
    /* Mobile horizontal scroll — NOT grid */
    @media (max-width: 768px) {
      .journal-row {
        overflow-x: auto;
        display: flex;
        gap: 20px;
        padding-bottom: 10px;
        -webkit-overflow-scrolling: touch;
      }
      .journal-row::-webkit-scrollbar {
        display: none;                /* Chrome, Safari */
      }
  
      .journal-card {
        flex: 0 0 70%;
      }
  
      {% comment %} .journal-img-wrap {
        padding-top: 140%;
      } {% endcomment %}
    }
    .journal-description {
      display: flex;
      gap: 06px;
      justify-content: center;
    }
    
    .journal-description p {
      margin: 0;
      font-size: 18px;
      font-weight: 400;
      color: rgba(0, 0, 0, 0.8);
    }
    .journal-description-2{
    font-style: italic;
    font-family: "libre-caslon-text", sans-serif;
    color: rgba(0, 0, 0, 0.8);
    font-size: 14px;
    }
    .journal-description-2-wrap p{
      font-size: 14px;
    }
    .journal-description-2-wrap{
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: bottom;
    }
    .journal-heading-wrap {
      display: flex;
      justify-content: center;
      gap: 6px;
    }
    
    .journal-heading {
      margin: 0;
      font-size: 38px;
      font-weight: 400;
      color: rgba(0, 0, 0, 0.8);
      margin-bottom: 20px;
    }
    
    .heading-1 {
      font-style: italic;
      font-family: "libre-caslon-text", serif;
    }
    .heading-2 {
     font-size: 40px;
     letter-spacing: 0.6rem;
     
     color: rgba(0, 0, 0, 0.75);
     transform: scaleX(1); /* expands letter width */
  display: inline-block;
  
    }
    .journal-title {
      font-size: 23px;
      margin: 10px 0;
      font-family: Roman;
      color: rgba(0, 0, 0, 0.7);
  }
  .journal-category {
    font-size: 1rem;
    margin-top: 12px;
    letter-spacing: 1px;
    color: rgba(0, 0, 0, 0.7);
}
.journal-button {
  font-size: 14px;
  border-bottom: 1px solid black;
  text-decoration: none;
  color: black;
  color: rgba(0, 0, 0, 0.7);
}
.journal-view {
  font-size: 12px;
  text-decoration: none;
  color: black;
  border-bottom: 1px solid black;
  color: rgba(0, 0, 0, 0.7);
}
.journal-heading-wrap {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 11px;
}
  

    
  </style>
  
  {% schema %}
  {
    "name": "The Journal",
    "settings": [
      {
        "type": "text",
        "id": "heading_1",
        "label": "Heading Line 1"
      },
      {
        "type": "text",
        "id": "heading_2",
        "label": "Heading Line 2"
      }
      ,
      {
        "type": "text",
        "id": "description_1",
        "label": "Description line 1"
      },
      {
        "type": "text",
        "id": "description_2",
        "label": "Description line 2"
      },
      {
        "type": "text",
        "id": "description_3",
        "label": "Description line 3"
      }
      ,
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "EXPLORE MORE"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "blocks": [
      {
        "type": "article_card",
        "name": "Article",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Article Image"
          },
          {
            "type": "text",
            "id": "category",
            "label": "Category",
            "default": "BLOG CATEGORY"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Article Title",
            "default": "Read the headline of a journal article over two or three lines of text if required."
          },
          {
            "type": "url",
            "id": "link",
            "label": "Article Link"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "The Journal"
      }
    ]
  }
  {% endschema %}
  