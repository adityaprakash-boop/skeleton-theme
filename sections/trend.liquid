<section class="trend-section">
    <div class="trend-container">
  
      {% if section.settings.trend_image != blank %}
        <div class="trend-image">
          <img 
            src="{{ section.settings.trend_image | image_url: width: 1200 }}" 
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
          >
        </div>
      {% endif %}
  
      <div class="trend-text">
        {% if section.settings.heading != blank %}
          <h2 class="trend-heading">{{ section.settings.heading }}</h2>
        {% endif %}
  
        {% if section.settings.subheading != blank %}
          <p class="trend-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
  
        {% if section.settings.description != blank %}
          <p class="trend-description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
  
    </div>
  </section>
  
  
 
  
  {% schema %}
  {
    "name": "Trend Section",
    "settings": [
      {
        "type": "image_picker",
        "id": "trend_image",
        "label": "Trend Image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Trending Now"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Sub-Heading",
        "default": "Trend su"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description",
        "default": "Write something about this trend..."
      }
    ],
    "presets": [
      {
        "name": "Trend Section"
      }
    ]
  }
  {% endschema %}
  