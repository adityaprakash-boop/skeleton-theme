{% comment %} /sections/founder-quote.liquid {% endcomment %}

{{ 'section-founder-quote.css' | asset_url | stylesheet_tag }}

{% if section.settings.image != blank %}
  <style>
    .founder-quote-section {
      background-image: url('{{ section.settings.image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  </style>
{% endif %}

<section class="banner banner--medium founder-banner section-{{ section.id }}-padding">
  <div class="banner__media media">
    {% if section.settings.image %}
      <img
        srcset="
          {{ section.settings.image | image_url: width: 400 }} 400w,
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        src="{{ section.settings.image | image_url: width: 1600 }}"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        class="banner__media-image"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="banner__content founder-quote__content">
    {% if section.settings.heading %}
      <h2 class="founder-quote__heading">{{ section.settings.heading }}</h2>
      <div class="founder-quote__divider"></div>
    {% endif %}

    {% if section.settings.quote %}
      <blockquote class="founder-quote__quote">"{{ section.settings.quote }}"</blockquote>
    {% endif %}

    {% if section.settings.author_name %}
      <p class="founder-quote__author">{{ section.settings.author_name }}</p>
    {% endif %}
  </div>
</section>


{% schema %}
{
  "name": "Founder Quote",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the founder,"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "I came to learn on my own journey that consistency shapes success. Doing something once is to be celebrated but doing that same thing day after day is the key to seeing real results."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author Name",
      "default": "Elle Macpherson"
    }
  ],
  "presets": [
    {
      "name": "Founder Quote"
    }
  ]
}
{% endschema %}
