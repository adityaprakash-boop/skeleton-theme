{{ 'section-proof-points.css' | asset_url | stylesheet_tag }}
<section class="proof-points">

    <div class="pp-top">
  
      <div class="pp-text">
        {% if section.settings.heading != blank %}
          <h2 class="pp-heading">{{ section.settings.heading }}</h2>
        {% endif %}
  
        {% if section.settings.subheading != blank %}
          <p class="pp-sub">{{ section.settings.subheading }}</p>
        {% endif %}
  
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="pp-button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        
      </div>
  
      <div class="pp-main-image">
        {% if section.settings.main_image != blank %}
          <img 
            src="{{ section.settings.main_image | image_url: width: 1200 }}"
            class="pp-main-img"
            loading="lazy">
        {% endif %}
  
        {% if section.settings.main_overlay_text != blank %}
          <div class="pp-overlay">
            {{ section.settings.main_overlay_text }}
          </div>
        {% endif %}
      </div>
  
    </div>
  
    <!-- Bottom 4 images -->
    <div class="pp-grid">
      {% for block in section.blocks %}
        <div class="pp-grid-item">
          {% if block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 800 }}"
              class="pp-grid-img"
              loading="lazy">
          {% endif %}
  
          {% if block.settings.text != blank %}
            <div class="pp-grid-text">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  
  </section>
  
  
  
  {% schema %}
  {
    "name": "Proof Points",
    "settings": [
      {
        "type": "image_picker",
        "id": "main_image",
        "label": "Main Right Image"
      },
      {
        "type": "text",
        "id": "main_overlay_text",
        "label": "Main Image Overlay Text",
        "default": "91%<br>saw results<br>within 30 days"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Left Heading",
        "default": "Innovative formulas."
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Left Subheading",
        "default": "Science-backed expertise."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "DISCOVER MORE"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      }
    ],
    "blocks": [
      {
        "type": "pp_item",
        "name": "Proof Point Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Overlay Text"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "Proof Points"
      }
    ]
  }
  {% endschema %}
  