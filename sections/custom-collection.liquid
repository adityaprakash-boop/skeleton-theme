<section class="collection-block-list">

    <div class="collection-block-wrapper">
  
      {% for block in section.blocks %}
        {% assign c = collections[block.settings.collection] %}
  
        {% if c %}
        <div class="collection-block" {{ block.shopify_attributes }}>
  
          <!-- Collection Title -->
          <h2 class="collection-title">{{ c.title }}</h2>
  
          <!-- Collection Description -->
          {% if c.description != blank %}
            <div class="collection-description">
              {{ c.description }}
            </div>
          {% endif %}
  
          <!-- Collection Products -->
          <div class="collection-products">
            {% for product in c.products %}
              <a href="{{ product.url }}" class="product-card">
                {{ product.featured_image | image_url: width: 400 | image_tag }}
                <p>{{ product.title }}</p>
              </a>
            {% endfor %}
          </div>
  
        </div>
        {% endif %}
  
      {% endfor %}
  
    </div>
  
  </section>
  
  {% schema %}
  {
    "name": "Multi Collection Section",
    "settings": [],
    "blocks": [
      {
        "type": "collection_block",
        "name": "Collection",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Select Collection"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Multi Collection Section"
      }
    ]
  }
  {% endschema %}
  
  {% style %}
  .collection-block-list {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  .collection-block {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  .collection-products {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  
  .product-card {
    width: 150px;
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  {% endstyle %}
  