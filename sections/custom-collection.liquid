{{ 'section-custom-collections.css' | asset_url | stylesheet_tag }}
<section class="collection-block-list" x-data>

    
        <div class="collection-banner">
            <div class="collection-banner-image">
          {% if section.settings.banner_image %}
            <img src="{{ section.settings.banner_image | image_url: width: 1800 }}" alt="Banner" class="collection-banner__image">
          {% endif %}
          </div>
        
          {% if section.settings.banner_text %}
            <div class="collection-banner__text">

              {{ section.settings.banner_text }}
            </div>
          {% endif %}
        </div>
        <div class="collection-nav">
            {% for block in section.blocks %}
              {% assign c = collections[block.settings.collection] %}
              {% if c %}
                <div class="collection-nav-item"
                  @click="$refs['c{{ forloop.index }}'].scrollIntoView({ behavior: 'smooth' })">
                  {{ c.title }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
          
        
        

    <div class="collection-block-wrapper">
  
      {% for block in section.blocks %}
        {% assign c = collections[block.settings.collection] %}
  
        {% if c %}
            <div class="collection-block"  x-ref="c{{ forloop.index }}">


          
          <div class="collection-info">
            <span class="collection-title">
                {{ block.settings.custom_title | default: c.title }}
            </span>
              
  
          
          {% if c.description != blank %}
            <div class="collection-description">
              {{ c.description }}
            </div>
          {% endif %}
          <div class="View-all-products">
            
            <span>VIEW ALL PRODUCTS</span>
          </div>
          </div>
          
          <div class="collection-products">
            {% for product in c.products %}
                <div class="product-card">
                  <a href="{{ product.url }}" class="product-card__link">
              
                    <div class="product-card__image-wrapper">
                      {% assign image = product.featured_media.preview_image %}
                      {% if image %}
                        <img
                          src="{{ image | image_url: width: 600 }}"
                          alt="{{ product.title }}"
                          class="product-card__image"
                        >
              
                        
                      {% endif %}
                    </div>
                    <div class="product-award">
                      {% if forloop.index == 1 %}
                        <img src="{{ 'award1.png' | asset_url }}" alt="Award 1">
                      {% elsif forloop.index == 2 %}
                        <img src="{{ 'award2.png' | asset_url }}" alt="Award 2">
                      {% else %}
                        <img src="{{ 'award3.png' | asset_url }}" alt="Award 3">
                      {% endif %}
                    </div>
                    
                    
                    
                 

              
                    <div class="product-card__info product-card__info--left">
              
                      <span class="product-card__title">
                        {{ product.title }}
                      </span>
              
                      
              
                      <div class="product-card__reviews product-card__reviews--left">
                        <span class="product-card__stars">★★★★☆</span>
                        <a href="#reviews" class="product-card__review-link">
                          <span class="product-card__review-count">10 Reviews</span>
                        </a>
                      </div>
              
                      <div class="product-card__price">
                        {% if product.compare_at_price > product.price %}
                          <s class="price__compare-at">{{ product.compare_at_price | money }}</s>
                        {% endif %}
                        <span class="price__regular">
                          {{ product.price | money }}
                        </span>
                      </div>
                      <div class="product-card__description">
                        <span class="product-card__description-text">
                          {{ product.description | strip_html }}
                        </span>
                      </div>
              
                      <div class="product-card__buttons">
                        <span class="product-btn subscribe-btn">SUBSCRIBE & SAVE 20%</span>
                        <span class="product-btn add-cart-btn">ADD TO CART</span>
                      </div>
              
                    </div>
              
                    
              
                  </a>
                  {% if block.settings.block_btn_text != blank %}
                    <div class="custom-product-button"
                      style="
                        background: {{ block.settings.block_btn_bg }};
                        color: {{ block.settings.block_btn_text_color }};
                      ">
                      {{ block.settings.block_btn_text }}
                    </div>
                  {% endif %}
                  
                </div>
              {% endfor %}
              
          </div>
  
        </div>
        {% endif %}
  
      {% endfor %}
  
    </div>
  
  </section>
  
  {% schema %}
  {
    "name": "Multi Collection Section",
    "settings": [
        {
            "type": "image_picker",
            "id": "banner_image",
            "label": "Banner Image"
          },
          {
            "type": "text",
            "id": "banner_text",
            "label": "Banner Text"
          }
    ],
    "blocks": [
      {
        "type": "collection_block",
        "name": "Collection",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Select Collection"
          },
          {
            "type": "text",
            "id": "custom_title",
            "label": "Custom Collection Title"
          },
          {
            "type": "image_picker",
            "id": "collection_block_image",
            "label": "Collection Block Image"
          },
          {
            "type": "text",
            "id": "custom_image_text",
            "label": "Collection Block Image Text"
          },
          {
            "type": "text",
            "id": "block_btn_text",
            "label": "Button Text",
            
          },
          {
            "type": "color",
            "id": "block_btn_text_color",
            "label": "Button Text Color",
            
          },
          
          {
            "type": "color",
            "id": "block_btn_bg",
            "label": "Button Background Color",
            
          }
          
          
        ]
      }
    ],
    "presets": [
      {
        "name": "Multi Collection Section"
      }
    ]
  }
  {% endschema %}
  
  
  