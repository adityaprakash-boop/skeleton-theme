<section class="brand-discovery">
    <div class="brand-grid">
      {% for block in section.blocks %}
        <div class="brand-item">
          {% if block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 1200 }}" 
              alt="{{ block.settings.text | escape }}"
              loading="lazy">
          {% endif %}
  
          {% if block.settings.text != blank %}
            <div class="brand-text">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  
    <div class="brand-content">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
  
      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
  
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="brand-button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </section>
  
  <style>
    .brand-discovery {
      padding: 60px 0;
    }
  
    /* Desktop: 4 images in a row */
    .brand-grid {
      display: flex;
      max-height: 45rem;
    }
  
    .brand-item {
      position: relative;
      flex: 1;
    }
  
    .brand-item img {
      width: 100%;
      display: block;
      object-fit: cover;
      height: 100%;
    }
  
    .brand-text {
      position: absolute;
      bottom: 50%;
      left: 15%;
      color: white;
      font-size: 20px;
      line-height: 1.4;
    }
  
    .brand-content {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 40px 20px;
      max-width: 700px;
    }
  
    .brand-button {
      display: inline-block;
      padding: 12px 26px;
      background: black;
      color: white;
      text-decoration: none;
      margin-top: 20px;
      width: 14rem;
      text-align: center;
    }
  
    /* Mobile: 2-column grid */
    @media (max-width: 768px) {
      .brand-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
      }
      .brand-text {
        font-size: 16px;
        bottom: 15px;
        left: 15px;
      }
    }
  </style>
  
  {% schema %}
  {
    "name": "Brand Discovery",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "THE PIONEER OF INGESTIBLE BEAUTY SINCE 2014"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "WelleCo is committed to empowering you to own your wellness journey. Naturally."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "ABOUT"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      }
    ],
    "blocks": [
      {
        "type": "image_text",
        "name": "Image + Text",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Overlay Text",
            "default": "With wellness, you can."
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "Brand Discovery"
      }
    ]
  }
  {% endschema %}
  